# Copy to .env on each server, or set PETTOWN_ENV_FILE to an absolute path.
# Select the profile outside this file: SPRING_PROFILES_ACTIVE=dev or prod.
SERVER_PORT=8080
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://127.0.0.1:3306/pettown?useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
