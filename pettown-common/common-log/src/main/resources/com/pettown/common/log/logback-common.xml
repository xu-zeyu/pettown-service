<?xml version="1.0" encoding="UTF-8"?>
<included>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{36} - %msg%n%wEx"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="ROOT_LOG_LEVEL" source="logging.level.root" defaultValue="WARN"/>
    <springProperty name="APPLICATION_LOG_LEVEL" source="logging.level.com.pettown" defaultValue="INFO"/>
    <logger name="com.pettown" level="${APPLICATION_LOG_LEVEL}"/>

    <springProfile name="!test">
        <springProperty name="APPLICATION_NAME" source="spring.application.name" defaultValue="pettown-server"/>
        <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
        <springProperty name="LOG_FILE" source="logging.file.name" defaultValue="${LOG_PATH}/${APPLICATION_NAME}.log"/>
        <springProperty name="MAX_FILE_SIZE" source="logging.logback.rollingpolicy.max-file-size" defaultValue="10MB"/>
        <springProperty name="MAX_HISTORY" source="logging.logback.rollingpolicy.max-history" defaultValue="7"/>
        <springProperty name="TOTAL_SIZE_CAP" source="logging.logback.rollingpolicy.total-size-cap" defaultValue="100MB"/>
        <springProperty name="CLEAN_HISTORY_ON_START" source="logging.logback.rollingpolicy.clean-history-on-start" defaultValue="true"/>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${MAX_HISTORY}</maxHistory>
                <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
                <cleanHistoryOnStart>${CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{36} - %msg%n%wEx</pattern>
            </encoder>
        </appender>

        <root level="${ROOT_LOG_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <springProfile name="test">
        <root level="${ROOT_LOG_LEVEL}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</included>
