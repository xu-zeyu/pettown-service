# Copy to .env in this module for bootRun, or next to the executable JAR.
SERVER_PORT=8082
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://127.0.0.1:3306/pettown?useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
PETTOWN_REDIS_ENABLED=true
# User sessions always use RedisTemplate; the flag above only controls Redisson business caching.
PETTOWN_TOKEN_TIMEOUT=2592000
# Enable Sa-Token operation logs only while troubleshooting.
SA_TOKEN_IS_LOG=false
