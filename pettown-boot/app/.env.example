# Copy this file to .env next to the executable JAR (or in this module for bootRun).
SERVER_PORT=8080
# Set to an empty value to enable JDBC auto-configuration when the database is ready.
# PETTOWN_AUTOCONFIG_EXCLUDES=
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://127.0.0.1:3306/pettown?useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
PETTOWN_REDIS_ENABLED=false
