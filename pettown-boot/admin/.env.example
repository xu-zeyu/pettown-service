# Copy this file to .env next to the executable JAR (or in this module for bootRun).
SERVER_PORT=8081
# Admin requires JDBC. Keep the exclusion empty.
# PETTOWN_AUTOCONFIG_EXCLUDES=
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://127.0.0.1:3306/pettown?useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
PETTOWN_REDIS_ENABLED=false
# Admin sessions always use RedisTemplate; the flag above controls optional Redisson business caching only.
PETTOWN_ADMIN_TOKEN_TIMEOUT=7200
# Enable only for initial provisioning, then disable and remove the password from the environment.
PETTOWN_ADMIN_BOOTSTRAP_ENABLED=false
PETTOWN_ADMIN_BOOTSTRAP_USERNAME=
PETTOWN_ADMIN_BOOTSTRAP_PASSWORD=
