# 禅道开源版 22.7 的实例根地址；优先 HTTPS 或本机受信任隧道。
ZENTAO_BASE_URL=http://127.0.0.1:18888/zentao
# 仅当用户明确要求使用部署好的 HTTP 实例时填精确主机:端口；此模式只接受现成 Token，禁用账号密码登录。
ZENTAO_ALLOW_HTTP_HOST=
# 二选一：优先使用 API V2 Token；留空时用账号密码调用 /api.php/v2/users/login。
ZENTAO_API_TOKEN=
ZENTAO_ACCOUNT=
ZENTAO_PASSWORD=
# 以下目标线索须由官方 API 只读回读核实；产品 ID 不得用项目 ID 代替。
ZENTAO_PROJECT_ID=1
ZENTAO_PROJECT_NAME=尾巴町
ZENTAO_PRODUCT_NAME=尾巴町
ZENTAO_PRODUCT_ID=
