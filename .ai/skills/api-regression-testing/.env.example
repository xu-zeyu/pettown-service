# Apifox 个人访问令牌（Apifox 账号设置 -> API 访问令牌）
APIFOX_ACCESS_TOKEN=
# 单目标兼容：--target-key default 时使用此 Apifox 项目 ID（项目设置 -> 基本设置）
APIFOX_PROJECT_ID=
# 按项目/服务映射：同一项目的 miniapp 和 admin 可对应不同 Apifox 项目；执行前逐目标请用户确认
APIFOX_PROJECT_IDS_JSON={"pet-system/miniapp":"","pet-system/admin":""}
# 可选：接口导入目标目录 ID；配置后仍须通过 Apifox endpoint list/get 或 UI 核对目录
APIFOX_TARGET_FOLDER_ID=
# 被测服务基础地址，禁止生产地址，例如 http://localhost:8080
API_BASE_URL=
# 按项目/服务映射测试环境；实际地址须核实，禁止生产地址
API_BASE_URLS_JSON={"pet-system/miniapp":"http://127.0.0.1:8082","pet-system/admin":"http://127.0.0.1:8081"}
# 禅道产品 ID 不等于项目 ID。由用户确认后填入对应项目/服务；无需禅道 Token，使用已连接 MCP。
ZENTAO_PRODUCT_IDS_JSON={"pet-system/miniapp":"","pet-system/admin":""}
