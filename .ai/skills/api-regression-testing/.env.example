# Apifox 个人访问令牌（Apifox 账号设置 -> API 访问令牌）
APIFOX_ACCESS_TOKEN=
# 单项目 Apifox 项目 ID（项目设置 -> 基本设置）
APIFOX_PROJECT_ID=
# 多项目映射：稳定项目 ID -> 各自 Apifox 项目 ID，执行前仍须逐一请用户确认
APIFOX_PROJECT_IDS_JSON={"pet-system":"","other-project":""}
# 可选：接口导入的目标目录 ID，不配置则导入到根目录
APIFOX_FOLDER_ID=
# 被测服务基础地址，禁止生产地址，例如 http://localhost:8080
API_BASE_URL=
# 多项目测试环境地址映射；实际地址以各项目已核实配置为准，禁止生产地址
API_BASE_URLS_JSON={"pet-system":"http://localhost:8080","other-project":"http://localhost:8081"}
