      "AuthRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "中国大陆手机号",
            "minLength": 1,
            "pattern": "^1[3-9]\\d{9}$"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "账号密码；8 到 72 位非空格 ASCII 字符",
            "minLength": 1,
            "pattern": "^[\\x21-\\x7E]{8,72}$",
            "writeOnly": true
          },
          "verificationCode": {
            "type": "string",
            "description": "六位数字验证码；登录即注册用途",
            "minLength": 1,
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          }
        },
        "required": [
          "password",
          "phone",
          "verificationCode"
        ]
      },
