<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pettown.business.admin.mapper.AdminPermissionMapper">

    <!-- 角色绑定的权限目录记录：按 admin_role_permission.permission_code 关联 admin_permission -->
    <select id="selectByRoleIds" resultType="com.pettown.business.admin.entity.AdminPermissionRecord">
        SELECT DISTINCT p.id, p.name, p.code
        FROM admin_permission p
        INNER JOIN admin_role_permission rp ON p.code = rp.permission_code
        WHERE rp.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>
</mapper>
